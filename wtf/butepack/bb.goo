package main

import (
	"crypto/aes"
	"crypto/cipher"
	"encoding/hex"
)

const (
	password = "x35k9f"
	msg      = `0ba7cd8c624345451df4710b81d1a349ce401e61bc7eb704ca` +
		`a84a8cde9f9959699f75d0d1075d676f1fe2eb475cf81f62ef` +
		`f701fee6a433cfd289d231440cf549e40b6c13d8843197a95f` +
		`8639911b7ed39a3aec4dfa9d286095c705e1a825b10a9104c6` +
		`be55d1079e6c6167118ac91318fe`
)

func decode256(msg string, key []byte) (string, error) {
	//key := sha256.Sum256([]byte(password)) // 1) получите ключ из password, используя sha256.Sum256
	aesblock, err := aes.NewCipher(key) // 2) создайте aesblock и aesgcm
	if err != nil {
		return "", err
	}
	aesgcm, err := cipher.NewGCM(aesblock)
	if err != nil {
		return "", err
	}
	// создаём вектор инициализации
	nonce := key[len(key)-aesgcm.NonceSize():] // 3) получите вектор инициализации aesgcm.NonceSize() байт с конца ключа
	encrypted := toHex(msg)    // 4) декодируйте сообщение msg в двоичный формат
	if err != nil {
		return "", err
	}
	// расшифровываем
	decrypted, err := aesgcm.Open(nil, nonce, encrypted, nil) // 5) расшифруйте и выведите данные
	if err != nil {
		panic(err)
	}
	return string(decrypted), nil
	// допишите код

	// ...
}

func toHex[SORB string | []byte](s SORB) string {
	heX, err := hex.DecodeString(string(s)) // 4) декодируйте сообщение msg в двоичный формат
	if err != nil {
		panic(err)
	}
	return string(heX)
}
